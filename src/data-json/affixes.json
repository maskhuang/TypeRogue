  "affixDescriptions": {
    "convert": "读取{source}的技能产出量加成",
    "rainbow": "每次触发时随机选择一种资源类型产出",
    "multiply": "产出直接乘以固定倍数",
    "charge": "按住蓄力，触发时释放产出倍率（×1.0~上限）；蓄满自动释放",
    "decay": "首次触发暴击率最高，逐次衰减至下限，每关重置",
    "crit": "触发时有概率暴击",
    "cascade": "上一个按键与当前键满足指定位置关系时，产出倍增",
    "void": "指定关系的空位越多加成越高",
    "swarm": "范围内每有1个虫群词条技能，所有虫群词条技能产出+加成",
    "mercenary": "金币≥N时触发加成产出，每次触发消耗N金币",
    "mirror": "每关结束时从指定关系的邻居中随机复制一个词条，下关替代自身生效",
    "amplify": "自身不产出；指定关系的匹配技能触发时叠层，指定关系的所有技能产出+叠层×{amplifyK}%",
    "splash": "自身不产出；触发时触发叠层数个指定关系的匹配技能",
    "resonance": "任意技能产出{resource}时叠层，满层触发自身",
    "echo": "拥有{affixA}或{affixB}的技能触发时叠层，满层触发自身",
    "fury": "任意技能暴击时叠层，满层触发自身",
    "tide": "每秒自动叠层，满层触发自身",
    "relay": "自身不产出；指定关系的匹配技能触发时，直接触发1个匹配技能（不含其他中转）",
    "conduit": "自身不产出，指定关系的匹配技能触发时额外触发一次",
    "outcast": "单词尾字母触发时暴击率+{bonusPercent}%",
    "gravity": "含本键字母的单词出现概率+{probMult}x；商店中匹配技能刷新概率提升",
    "ligature": "字母在当前单词中重复出现时，按出现次数倍增产出",
    "war_drum": "自身不产出；指定关系的匹配技能触发时叠层，指定关系的所有技能暴击率+叠层×{critPerStack}%",
    "twin": "获得附魔时同时获得两个（而非二选一）",
    "recurse": "增加暴击率，暴击时额外触发一次（每次暴击率减半）",
    "taboo": "大幅增加暴击率，若未暴击则产出负值",
    "flow": "指定关系内每个同资源且等级更高的邻居+{flowK}%",
    "confluence": "指定关系的邻居资源类型越多样，产出加成越高",
    "union": "指定关系的匹配技能越多，产出加成越高",
    "innate": "每关开始时自动触发一次（不需按键）",
    "exhaust": "每次触发产出倍增，但触发次数有限，用完词条消失",
    "fallacy": "连续未暴击时暴击率逐次递增，暴击后归零重新累积",
    "reflect": "技能词条越多、等级越高，产出越高",
    "monkey_patch": "每关随机修改同技能一个词条的效果倍率",
    "excavate": "被蜕变时获得遗物",
    "treasure": "被蜕变时下次商店保底出现指定稀有度商品",
    "refine": "被蜕变时退还变异素",
    "evolve": "被蜕变时有概率提升技能稀有度",
    "harvest": "被蜕变时获得金币",
    "chain": "被蜕变时指定关系的技能也一起蜕变",
    "volatile": "被蜕变后本技能短期内效果翻倍",
    "mutacrit": "被蜕变时本技能永久获得暴击率",
    "ascend": "被蜕变时本技能升级",
    "reecho": "打错时也能触发技能产出，但每次打错累积-{reechoPenalty}%产出惩罚，逐词重置",
    "myopia": "产出+{myopiaBonus}%，但每次触发目标分数增加{myopiaCost}",
    "aura_fury": "自身不产出；指定关系内匹配技能暴击率+{auraCrit}%",
    "aura_morale": "自身不产出；指定关系内匹配技能产出+{auraMorale}%",
    "fiber": "首字母触发时额外叠层，满层触发尾字母键上的技能",
    "silkworm": "触发时当前字母不产生底分；产出+(累积损失底分 × {silkwormK}%)",
    "repulsion": "含本键字母的单词出现概率 ×{probMult}；商店中匹配技能刷新概率降低",
    "handoff": "本词之后第一个将触发的技能额外触发{handoffCount}次",
    "rewind": "依次让本词之前已触发的最近{rewindCount}个技能各额外触发1次",
    "endow": "本次不产出；将本应产出量（标准化后）加到本词之后{endowCount}个技能的基础产出",
    "proofread": "本词未被触发则+1层，满{proofreadInterval}层时词末自动触发1次",
    "spelling": "触发时元音+2层、辅音+1层，满{spellingInterval}层时额外自触发1次",
    "first_edition": "本词是本关首次出现时，产出×{firstEditionMult}",
    "reprint": "本词在本关已出现N次时，产出+{reprintK}×N%",
    "matrix": "本词每含1个字母碎片队列中的字母，产出+{matrixK}%",
    "typeset": "本词每有1个字母，产出+{typesetK}%"
  },
