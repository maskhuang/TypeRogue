# aigc-art 环境变量配置
#
# 使用方式：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 填入真实 token
#   3. gen.py 会自动加载（gen.py 启动时读 aigc-art/.env）
#
# .env 已在 .gitignore 中，不会入库。

# ============================================================
# Replicate API Token（必填，烧真钱时）
# ============================================================
# 获取地址：https://replicate.com/account/api-tokens
# 格式：r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REPLICATE_API_TOKEN=

# ============================================================
# 可选：覆盖默认模型 / LoRA（调试用）
# ============================================================
# AIGC_MODEL_ID=black-forest-labs/flux-dev
# AIGC_LORA_NAME=retro-pixel-flux
# AIGC_LORA_WEIGHT=0.85

# ============================================================
# 可选：HuggingFace token（如需拉 gated LoRA 或 fine-tune）
# ============================================================
# HF_TOKEN=hf_xxx
